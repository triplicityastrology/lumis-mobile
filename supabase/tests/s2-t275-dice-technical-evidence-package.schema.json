{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2_t275_dice_technical_evidence_package_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "source_commit", "package_sha256", "technical_case_count", "founder_case_count", "language", "attempt_total", "concurrency_peak", "cost_ceiling_usd", "provider_disabled_verified", "effects", "records"],
  "properties": {
    "schema": { "const": "s2_t275_dice_technical_evidence_package_v1" },
    "run_id": { "type": "string", "pattern": "^dice-tech80-[a-z0-9]{16,40}$" },
    "source_commit": { "const": "776620bfa1bf3c80090313c83e753cb3004db50d" },
    "package_sha256": { "const": "3ccc7551fd945b4ca4c3aaeaa7b8f9efd61f29b56e8ebe3c69ea9f5c5aaae8ba" },
    "technical_case_count": { "const": 80 },
    "founder_case_count": { "const": 0 },
    "language": { "type": "object", "additionalProperties": false, "required": ["en", "zh-Hant"], "properties": { "en": { "const": 40 }, "zh-Hant": { "const": 40 } } },
    "attempt_total": { "type": "integer", "minimum": 0, "maximum": 160 },
    "concurrency_peak": { "type": "integer", "minimum": 0, "maximum": 2 },
    "cost_ceiling_usd": { "const": 0.128 },
    "provider_disabled_verified": { "const": true },
    "effects": { "type": "object", "additionalProperties": false, "required": ["normal_routes", "units_charged", "persistence_writes"], "properties": { "normal_routes": { "const": 0 }, "units_charged": { "const": 0 }, "persistence_writes": { "const": 0 } } },
    "records": { "type": "array", "minItems": 80, "maxItems": 80, "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run_id", "fixture_id", "phase", "language", "result_class", "attempt_count", "input_tokens", "output_tokens", "duration_ms", "concurrency_peak", "redacted_failure_code", "observed_at", "retain_until", "effects"],
      "properties": {
        "schema": { "const": "lumis_dice_synthetic_metadata_evidence_v1" },
        "run_id": { "type": "string", "pattern": "^dice-tech80-[a-z0-9]{16,40}$" },
        "fixture_id": { "type": "string", "pattern": "^DICE-TECH-(EN|ZH)-[A-Z0-9-]+-[0-9]{2}$" },
        "phase": { "const": "technical" },
        "language": { "enum": ["en", "zh-Hant"] },
        "result_class": { "enum": ["completed", "safety", "excluded", "fallback", "technical_error"] },
        "attempt_count": { "type": "integer", "minimum": 0, "maximum": 2 },
        "input_tokens": { "type": "integer", "minimum": 0, "maximum": 800 },
        "output_tokens": { "type": "integer", "minimum": 0, "maximum": 300 },
        "duration_ms": { "type": "number", "minimum": 0, "maximum": 12000 },
        "concurrency_peak": { "type": "integer", "minimum": 0, "maximum": 2 },
        "redacted_failure_code": { "enum": ["none", "safety_block", "scope_excluded", "provider_timeout", "provider_rate_limited", "provider_unavailable", "provider_malformed", "defaultv2_block", "defaultv2_partial", "input_token_cap", "output_token_cap"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "retain_until": { "type": "string", "format": "date-time" },
        "effects": { "type": "object", "additionalProperties": false, "required": ["normal_routes", "units_charged", "persistence_writes"], "properties": { "normal_routes": { "const": 0 }, "units_charged": { "const": 0 }, "persistence_writes": { "const": 0 } } }
      }
    }
  }
}
