    "project_ref": { "const": "bmqhwofmdgebpcihjlnb" },
    "function_name": { "const": "dice-synthetic" },
    "source_commit": { "$ref": "#/$defs/git" },
    "source_tree": { "$ref": "#/$defs/git" },
    "package_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_package_sha256": { "const": "be911dd5f335217b4d00bbce34f0bd27cd9fcdc7c50152b4406b3b3058528457" },
    "founder_registry_sha256": { "const": "a6f2700b5b689bc00a130bde083e2efbce1a83ac64df8ddaee5565b2f2e9d211" },
    "configuration_names": { "type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": { "type": "string", "pattern": "^LUMIS_DICE_[A-Z0-9_]+$" } },
    "kill_switch_required": { "const": false },
    "traffic_switch_required": { "const": false },
    "provider_calls_authorized": { "const": 0 },
    "model_invocations_authorized": { "const": 0 },
    "disabled_probes": { "const": ["unknown_fixture", "free_form_body", "normal_mobile_body", "allow_listed_fixture"] },
    "migration_0039_authorized": { "const": false },
    "rollback_target": { "const": "REMOVE_OR_RESTORE_DICE_SYNTHETIC_ONLY_KEEP_PROVIDER_DISABLED" },
    "rollback_revision_required": { "const": true },
    "authorization_window_seconds": { "const": 900 },
    "clock_policy": { "const": "SIGNED_RECEIPT_ISSUED_AT_PLUS_RELATIVE_WINDOW" },
    "normal_chat_unchanged_required": { "const": true },
    "request_sha256": { "$ref": "#/$defs/sha256" }
