      "properties": {
        "gateway": { "$ref": "#/$defs/sha" }, "registry": { "$ref": "#/$defs/sha" }, "registry_payload": { "$ref": "#/$defs/sha" },
        "adapter": { "$ref": "#/$defs/sha" }, "response_schema": { "$ref": "#/$defs/sha" }, "operator": { "$ref": "#/$defs/sha" }
      }
    },
    "provider_authority": { "$ref": "#/$defs/provider_authority" },
