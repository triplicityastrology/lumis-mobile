        "deployment_type": { "const": "GlobalStandard" }, "model_version_upgrade_policy": { "const": "NoAutoUpgrade" }, "guardrail": { "const": "Microsoft.DefaultV2" },
        "tokens_per_minute_limit": { "const": 10000 }, "requests_per_minute_limit": { "const": 10 },
