{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2_t287_dice_default_off_deployment_receipt_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "project_ref", "function_name", "deployment_id", "authorization_sha256", "request_sha256", "signing_key_sha256", "source_commit", "source_tree", "runtime_package_sha256", "authorization_package_sha256", "configuration_names_verified", "kill_switch_disabled", "traffic_switch_disabled", "function_version", "rollback_revision", "disabled_probes", "provider_calls", "model_invocations", "normal_chat_unchanged", "migration_applied", "rollback_target", "deployed_at", "credentials_unset"],
  "properties": {
    "schema": { "const": "s2_t287_dice_default_off_deployment_receipt_v1" },
    "project_ref": { "const": "bmqhwofmdgebpcihjlnb" }, "function_name": { "const": "dice-synthetic" },
    "deployment_id": { "type": "string", "pattern": "^dice-deploy-[a-z0-9]{16,40}$" },
    "authorization_sha256": { "$ref": "#/$defs/sha256" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "signing_key_sha256": { "$ref": "#/$defs/sha256" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "source_tree": { "$ref": "#/$defs/commit" },
    "runtime_package_sha256": { "$ref": "#/$defs/sha256" },
    "authorization_package_sha256": { "$ref": "#/$defs/sha256" },
    "configuration_names_verified": { "const": true }, "kill_switch_disabled": { "const": true }, "traffic_switch_disabled": { "const": true },
    "function_version": { "type": "integer", "minimum": 1 },
    "rollback_revision": { "type": "string", "pattern": "^[a-zA-Z0-9._:-]{1,120}$" },
    "disabled_probes": { "type": "object", "additionalProperties": false, "required": ["unknown_fixture", "free_form_body", "normal_mobile_body", "allow_listed_fixture"], "properties": { "unknown_fixture": { "const": "DICE_AI_DISABLED" }, "free_form_body": { "const": "DICE_AI_DISABLED" }, "normal_mobile_body": { "const": "DICE_AI_DISABLED" }, "allow_listed_fixture": { "const": "DICE_AI_DISABLED" } } },
    "provider_calls": { "const": 0 }, "model_invocations": { "const": 0 }, "normal_chat_unchanged": { "const": true }, "migration_applied": { "const": false },
    "rollback_target": { "const": "REMOVE_OR_RESTORE_DICE_SYNTHETIC_ONLY_KEEP_PROVIDER_DISABLED" },
    "deployed_at": { "type": "string", "format": "date-time" }, "credentials_unset": { "const": true }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" } }
}
