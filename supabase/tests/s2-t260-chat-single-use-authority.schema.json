{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2_t260_chat_single_use_authority_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "scope", "gateway_interface", "review_package_sha256", "gateway_source_sha256", "fixture_registry_sha256", "canonical_t240_schema_sha256", "dice_evidence_sha256", "run_id", "caps", "issued_at", "valid_until"],
  "properties": {
    "schema": { "const": "s2_t260_chat_single_use_authority_v1" },
    "authority": { "const": "CHAT_SYNTHETIC_SINGLE_USE_AUTHORIZED" },
    "scope": { "const": "closed_fixture_registry_60" },
    "gateway_interface": { "const": "chat_synthetic_gateway_port_v1" },
    "review_package_sha256": { "$ref": "#/$defs/sha" },
    "gateway_source_sha256": { "$ref": "#/$defs/sha" },
    "fixture_registry_sha256": { "$ref": "#/$defs/sha" },
    "canonical_t240_schema_sha256": { "const": "0cd1fc47147beeb7a47df89952a7743ef4ab8c6e7ecd5a875f4a724154bcfa07" },
    "dice_evidence_sha256": { "$ref": "#/$defs/sha" },
    "run_id": { "type": "string", "pattern": "^chat-syn-[a-z0-9]{12,32}$" },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical", "en", "zh_hant", "attempts", "input_tokens", "output_tokens", "concurrency", "deadline_ms", "retries"],
      "properties": {
        "logical": { "const": 60 }, "en": { "const": 30 }, "zh_hant": { "const": 30 }, "attempts": { "const": 120 },
        "input_tokens": { "const": 1200 }, "output_tokens": { "const": 300 }, "concurrency": { "const": 1 }, "deadline_ms": { "const": 12000 }, "retries": { "const": 1 }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
