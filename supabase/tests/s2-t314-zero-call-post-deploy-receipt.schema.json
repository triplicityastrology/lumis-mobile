    "source_commit": { "$ref": "#/$defs/git" },
    "source_tree": { "$ref": "#/$defs/git" },
    "package_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_package_sha256": { "$ref": "#/$defs/sha256" },
    "founder_registry_sha256": { "$ref": "#/$defs/sha256" },
    "kill_switch_disabled": { "const": true },
    "traffic_switch_disabled": { "const": true },
    "function_version": { "type": "integer", "minimum": 1 },
