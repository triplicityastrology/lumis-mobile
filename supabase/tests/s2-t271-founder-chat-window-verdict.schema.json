{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "founder_chat_window_verdict_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "sha256"],
  "properties": {
    "sha256": { "$ref": "#/$defs/sha" },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "build_sha", "chat_runtime_commit", "dice_runtime_commit", "fixture_export_sha256", "accepted_execution_evidence_sha256", "post_window_disabled_proof_sha256", "authority_status", "entries"],
      "properties": {
        "schema_version": { "const": "founder_chat_window_verdict_v1" },
        "build_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "chat_runtime_commit": { "const": "3bc762c05cf10589bc2ec27ee3e4fd23a1ce6da9" },
        "dice_runtime_commit": { "const": "f5f9e9da238633d84eb8695307c573eef8f1bc96" },
        "fixture_export_sha256": { "$ref": "#/$defs/sha" },
        "accepted_execution_evidence_sha256": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "post_window_disabled_proof_sha256": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "authority_status": { "type": "object", "additionalProperties": false, "required": ["normal_chat", "azure_traffic"], "properties": { "normal_chat": { "const": "NO_NORMAL_CHAT_INTEGRATION_AUTHORITY" }, "azure_traffic": { "const": "NO_AZURE_TRAFFIC_AUTHORITY" } } },
        "entries": {
          "type": "array", "maxItems": 60,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fixture_id", "language", "surface", "ratings", "verdict"],
            "properties": {
              "fixture_id": { "type": "string", "pattern": "^chat_(en|zh_hant)_[a-z0-9_]+_v1$" },
              "language": { "enum": ["en", "zh-Hant"] },
              "surface": { "enum": ["companion", "normal_chat"] },
              "verdict": { "enum": ["pending", "accepted", "returned"] },
              "ratings": {
                "type": "object", "additionalProperties": false,
                "required": ["correctness", "usefulness", "tone", "translation_quality", "vagueness", "repetition", "overconfidence", "safety"],
                "properties": {
                  "correctness": { "$ref": "#/$defs/rating" }, "usefulness": { "$ref": "#/$defs/rating" }, "tone": { "$ref": "#/$defs/rating" },
                  "translation_quality": { "$ref": "#/$defs/rating" }, "vagueness": { "$ref": "#/$defs/rating" }, "repetition": { "$ref": "#/$defs/rating" },
                  "overconfidence": { "$ref": "#/$defs/rating" }, "safety": { "$ref": "#/$defs/rating" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "rating": { "type": "integer", "minimum": 1, "maximum": 5 } }
}
