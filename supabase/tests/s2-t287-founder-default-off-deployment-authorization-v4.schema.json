{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumis_dice_default_off_function_deployment_authorization_v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "issuer", "decision", "authorization_scope", "request_id", "request_sha256", "project_ref", "function_name", "single_use_deployment_id", "issued_at", "authorization_window_seconds", "clock_policy", "source_commit", "source_tree", "runtime_package_sha256", "authorization_package_sha256", "bindings", "issuer_public_key_spki_sha256", "issuer_key_id", "trust_anchor_owner", "configuration_names", "kill_switch_required", "traffic_switch_required", "provider_calls_authorized", "model_invocations_authorized", "disabled_probes", "migration_application_authorized", "migration_required_authorization_scope", "normal_chat_binding", "rollback_target", "rollback_revision", "signature_algorithm", "issuer_signature_base64"],
  "properties": {
    "schema": { "const": "lumis_dice_default_off_function_deployment_authorization_v4" },
    "issuer": { "const": "Lumis Founder Deployment Approver" }, "decision": { "const": "AUTHORIZED" },
    "authorization_scope": { "const": "DEFAULT_OFF_DICE_SYNTHETIC_FUNCTION_DEPLOYMENT_ONLY" },
    "request_id": { "type": "string", "pattern": "^dice-auth-request-[a-z0-9]{16,40}$" },
    "request_sha256": { "$ref": "s2-t287-default-off-deployment-authorization-request-v4.schema.json#/$defs/sha256" },
    "project_ref": { "const": "bmqhwofmdgebpcihjlnb" }, "function_name": { "const": "dice-synthetic" },
    "single_use_deployment_id": { "type": "string", "pattern": "^dice-deploy-[a-z0-9]{16,40}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "authorization_window_seconds": { "const": 900 },
    "clock_policy": { "const": "SIGNED_RECEIPT_ISSUED_AT_PLUS_RELATIVE_WINDOW" },
    "source_commit": { "$ref": "s2-t287-default-off-deployment-authorization-request-v4.schema.json#/$defs/commit" },
    "source_tree": { "$ref": "s2-t287-default-off-deployment-authorization-request-v4.schema.json#/$defs/commit" },
    "runtime_package_sha256": { "$ref": "s2-t287-default-off-deployment-authorization-request-v4.schema.json#/$defs/sha256" },
    "authorization_package_sha256": { "$ref": "s2-t287-default-off-deployment-authorization-request-v4.schema.json#/$defs/sha256" },
    "bindings": { "$ref": "s2-t287-default-off-deployment-authorization-request-v4.schema.json#/$defs/bindings" },
    "issuer_public_key_spki_sha256": { "$ref": "s2-t287-default-off-deployment-authorization-request-v4.schema.json#/$defs/sha256" },
    "issuer_key_id": { "type": "string", "pattern": "^founder-ed25519-[a-z0-9-]{8,48}$" },
    "trust_anchor_owner": { "const": "Founder" },
    "configuration_names": { "type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": { "type": "string", "pattern": "^LUMIS_DICE_[A-Z0-9_]+$" } },
    "kill_switch_required": { "const": false }, "traffic_switch_required": { "const": false },
    "provider_calls_authorized": { "const": 0 }, "model_invocations_authorized": { "const": 0 },
    "disabled_probes": { "const": ["unknown_fixture", "free_form_body", "normal_mobile_body", "allow_listed_fixture"] },
    "migration_application_authorized": { "const": false },
    "migration_required_authorization_scope": { "const": "DICE_AUTHORITY_LEDGER_0039_MIGRATION_ONLY" },
    "normal_chat_binding": { "$ref": "s2-t287-default-off-deployment-authorization-request-v4.schema.json#/$defs/normalChat" },
    "rollback_target": { "const": "REMOVE_OR_RESTORE_DICE_SYNTHETIC_ONLY_KEEP_PROVIDER_DISABLED" },
    "rollback_revision": { "type": "string", "pattern": "^(absent|version-[0-9]+)$" },
    "signature_algorithm": { "const": "Ed25519" },
    "issuer_signature_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  }
}
