{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2_t260_accepted_dice_technical_evidence_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "review_decision", "technical_evidence_schema", "technical_evidence_package_sha256", "logical_total", "en", "zh_hant", "provider_disabled_verified", "founder_cases_run", "persistence_writes", "units_charged", "accepted_at"],
  "properties": {
    "schema": { "const": "s2_t260_accepted_dice_technical_evidence_v1" },
    "review_decision": { "const": "accepted" },
    "technical_evidence_schema": { "const": "s2_t254_dice_technical_evidence_package_v1" },
    "technical_evidence_package_sha256": { "$ref": "#/$defs/sha" },
    "logical_total": { "const": 80 },
    "en": { "const": 40 },
    "zh_hant": { "const": 40 },
    "provider_disabled_verified": { "const": true },
    "founder_cases_run": { "const": 0 },
    "persistence_writes": { "const": 0 },
    "units_charged": { "const": 0 },
    "accepted_at": { "type": "string", "format": "date-time" }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
