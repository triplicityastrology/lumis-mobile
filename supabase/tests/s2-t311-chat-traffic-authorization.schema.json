{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S2-T311 synthetic Chat traffic authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision", "package_sha256", "accepted_dice_evidence_sha256", "scope", "valid_until", "single_use"],
  "properties": {
    "schema": { "const": "s2_t311_chat_synthetic_traffic_authorization_v1" },
    "decision": { "const": "accepted" },
    "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "accepted_dice_evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": { "const": "SYNTHETIC_CHAT_FIXTURE_IDS_ONLY" },
    "valid_until": { "type": "string", "format": "date-time" },
    "single_use": { "const": true }
  }
}
