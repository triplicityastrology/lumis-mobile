{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2_t256_founder_ai_review_interface_v1",
  "title": "Founder AI synthetic review record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "section", "language", "expected_class", "state", "rendered_output", "latency_bucket", "input_token_bucket", "output_token_bucket", "attempt_count", "result_class", "retry_class"],
  "properties": {
    "schema_version": { "const": "s2_t256_founder_ai_review_v1" },
    "fixture_id": { "type": "string", "pattern": "^(DICE-FOUNDER-(EN|ZH)-[0-9]{2}|chat_(en|zh_hant)_[a-z0-9_]+)$" },
    "section": { "enum": ["dice", "companion_chat"] },
    "language": { "enum": ["en", "zh-Hant"] },
    "expected_class": { "enum": ["judgment", "descriptive", "safety", "fallback", "technical_error"] },
    "state": { "enum": ["not_yet_run", "offline_preview", "live_synthetic", "blocked", "fallback"] },
    "rendered_output": { "type": ["string", "null"], "maxLength": 1200 },
    "latency_bucket": { "enum": ["not_run", "under_3s", "3_to_8s", "8_to_12s", "timeout"] },
    "input_token_bucket": { "enum": ["not_run", "0_to_400", "401_to_800", "801_to_1200"] },
    "output_token_bucket": { "enum": ["not_run", "0_to_150", "151_to_300"] },
    "attempt_count": { "enum": [0, 1, 2] },
    "result_class": { "enum": ["not_run", "completed", "safety_redirect", "fixed_fallback", "technical_error"] },
    "retry_class": { "enum": ["none", "eligible_once", "retried_once", "not_eligible"] }
  }
}
