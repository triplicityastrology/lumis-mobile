  "$defs": {
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["schema","project_ref","function_name","candidate_commit","candidate_package_sha256","deployment_id","disabled_probes","both_switches_false","provider_calls","model_invocations","migration_applied","normal_chat_unchanged","recorded_at"],
      "properties": {
        "schema": { "const": "s2_t314_post_deploy_disabled_receipt_v1" }, "project_ref": { "const": "bmqhwofmdgebpcihjlnb" }, "function_name": { "const": "dice-synthetic" },
        "candidate_commit": { "const": "179de7e43fd208858d18398586543028ba9d1b5f" }, "candidate_package_sha256": { "const": "8b8a545986c756403338a93b3b832762a0918e061d044e27710d27146fc33a71" },
        "deployment_id": { "type": "string", "pattern": "^dice-deploy-[a-z0-9]{16,40}$" },
