{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2_t315_post_action_receipts_v1",
  "oneOf": [
    { "$ref": "#/$defs/deployment" },
    { "$ref": "#/$defs/migration" },
    { "$ref": "#/$defs/traffic" }
