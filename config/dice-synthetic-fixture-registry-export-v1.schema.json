{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumis://schemas/dice-synthetic-fixture-registry-export-v1",
  "title": "Dice synthetic fixture registry export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "prompt_version", "registry_checksum", "technical_cases", "founder_slots"],
  "properties": {
    "schema_version": { "const": "dice_synthetic_fixture_registry_export_v1" },
    "registry_version": { "const": "dice-synthetic-registry-v0.3.0" },
    "prompt_version": { "const": "dice-v0.3-synthetic-prompt-1" },
    "registry_checksum": { "const": "43cccc009f15a43c1801bd090234540e474a6cb20a1a48aa3a3bcd9b86a1a030" },
    "technical_cases": {
      "type": "array",
      "minItems": 80,
      "maxItems": 80,
      "items": { "$ref": "#/$defs/fixture" }
    },
    "founder_slots": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/slot" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "language", "question", "expected_route", "expected_result_class", "rubric_tags"],
      "properties": {
        "fixture_id": { "type": "string", "pattern": "^DICE-(TECH|FOUNDER)-(EN|ZH)-[A-Z0-9-]+$" },
        "language": { "enum": ["en", "zh-Hant"] },
        "question": { "type": "string", "minLength": 8, "maxLength": 280 },
        "expected_route": { "enum": ["judgment", "descriptive_reflection", "none"] },
        "expected_result_class": { "enum": ["interpretation", "safety_redirect", "scope_excluded", "default_v2_block", "malformed_provider", "transient_retry", "schema_rejected"] },
        "rubric_tags": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "language", "status"],
      "properties": {
        "fixture_id": { "type": "string", "pattern": "^DICE-FOUNDER-(EN|ZH)-[0-9]{2}$" },
        "language": { "enum": ["en", "zh-Hant"] },
        "status": { "const": "reserved" }
      }
    }
  }
}
