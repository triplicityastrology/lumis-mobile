  "required": ["schema", "interface_version", "deployment_receipt_sha256", "runtime_package_sha256", "technical_evidence_sha256", "founder_fixture_package_sha256", "fixture_total", "language_totals", "invocation_shape", "requested_scope", "requested_status", "effects"],
