{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2_t261_founder_verdict_v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_contract_version", "build_sha", "generated_from", "entries"],
  "properties": {
    "schema_version": { "const": "s2_t261_founder_verdict_v2" },
    "review_contract_version": { "const": "s2_t261_founder_ai_review_v2" },
    "build_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generated_from": { "const": "local_founder_console" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "ratings", "verdict"],
        "properties": {
          "fixture_id": { "type": "string", "pattern": "^DICE-FOUNDER-(EN|ZH)-(0[1-9]|1[0-9]|20)$" },
          "ratings": { "type": "object" },
          "verdict": { "enum": ["pending", "accepted", "returned"] }
        }
      }
    }
  }
}
