{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2_t280_founder_window_authorization_receipt_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "authorization_scope", "request_sha256", "runtime_package_sha256", "technical_evidence_sha256", "fixture_package_sha256", "fixture_total", "language_totals", "single_use_window_id", "valid_until", "invocation_shape"],
  "properties": {
    "schema_version": { "const": "s2_t280_founder_window_authorization_receipt_v1" },
    "status": { "const": "accepted" },
    "authorization_scope": { "const": "DICE_FOUNDER_SYNTHETIC_WINDOW_40_ONLY" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_package_sha256": { "$ref": "#/$defs/sha256" },
    "technical_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "fixture_package_sha256": { "$ref": "#/$defs/sha256" },
    "fixture_total": { "const": 40 },
    "language_totals": { "type": "object", "additionalProperties": false, "required": ["en", "zh-Hant"], "properties": { "en": { "const": 20 }, "zh-Hant": { "const": 20 } } },
    "single_use_window_id": { "type": "string", "pattern": "^dice-founder40-[a-z0-9]{16,40}$" },
    "valid_until": { "type": "string", "format": "date-time" },
    "invocation_shape": { "const": "fixture_id_only" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
