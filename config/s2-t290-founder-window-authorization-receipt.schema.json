{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lumis_dice_founder_window_authorization_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "issuer", "decision", "authorization_scope", "request_sha256", "runtime_package_sha256", "technical_evidence_sha256", "fixture_package_sha256", "fixture_total", "language_totals", "single_use_window_id", "issued_at", "valid_until", "invocation_shape", "signature_algorithm", "microsoft_signature_base64"],
  "properties": {
    "schema": { "const": "lumis_dice_founder_window_authorization_v1" },
    "issuer": { "const": "Microsoft" },
    "decision": { "const": "AUTHORIZED" },
    "authorization_scope": { "const": "DICE_FOUNDER_SYNTHETIC_WINDOW_40_ONLY" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_package_sha256": { "const": "be911dd5f335217b4d00bbce34f0bd27cd9fcdc7c50152b4406b3b3058528457" },
    "technical_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "fixture_package_sha256": { "$ref": "#/$defs/sha256" },
    "fixture_total": { "const": 40 },
    "language_totals": { "type": "object", "additionalProperties": false, "required": ["en", "zh-Hant"], "properties": { "en": { "const": 20 }, "zh-Hant": { "const": 20 } } },
    "single_use_window_id": { "type": "string", "pattern": "^dice-founder40-[a-z0-9]{16,40}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "invocation_shape": { "const": "fixture_id_only" },
    "signature_algorithm": { "const": "Ed25519" },
    "microsoft_signature_base64": { "type": "string", "minLength": 80, "maxLength": 120 }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
